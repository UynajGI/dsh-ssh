{
  "name": "dsh-ssh",
  "version": "0.2.2",
  "description": "SSH remote-execution plugin for DeepSeek Harness — ProxyJump chain, SFTP filesystem, subprocess and PTY over ssh2",
  "type": "module",
  "license": "MIT",
  "author": "yuunagi_cn <yuunagi.cn@outlook.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/UynajGI/dsh-ssh.git"
  },
  "bugs": {
    "url": "https://github.com/UynajGI/dsh-ssh/issues"
  },
  "homepage": "https://github.com/UynajGI/dsh-ssh",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./ssh": {
      "types": "./lib/runtime.d.ts",
      "default": "./lib/runtime.js"
    },
    "./subprocess": {
      "types": "./lib/subprocess.d.ts",
      "default": "./lib/subprocess.js"
    },
    "./fs": {
      "types": "./lib/filesystem.d.ts",
      "default": "./lib/filesystem.js"
    },
    "./picker": {
      "types": "./lib/picker.d.ts",
      "default": "./lib/picker.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "prepublishOnly": "npm run typecheck && npm run build",
    "release": "commit-and-tag-version"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ssh",
    "remote-development",
    "proxyjump",
    "sftp",
    "directory-picker",
    "add-workspace"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-directory-picker": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@types/node": "^22.0.0",
    "@types/ssh2": "^1.15.5",
    "commit-and-tag-version": "^13.1.2",
    "husky": "^9.0.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.0"
  }
}
